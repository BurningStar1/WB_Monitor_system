# --- Wildberries API --------------------------------------------
# Токен Seller API (Статистика, Финансовые отчёты, Продвижение).
# Получить: личный кабинет WB -> Настройки -> Доступ к API -> Статистика.
# Можно оставить пустым и ввести через UI (Home -> вкладка «Данные и API»).
WB_API_TOKEN=
WB_API_HOST=https://statistics-api.wildberries.ru

# --- PostgreSQL -------------------------------------------------
# Подключение к локальной или удалённой базе wb_analytics.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=wb_analytics
DB_USER=postgres
DB_PASSWORD=postgres

# --- Логи и служебное ------------------------------------------
LOG_LEVEL=INFO
RAW_SOURCE=wildberries

# --- Пользователи веб-интерфейса -------------------------------
# Список "логин:пароль", разделитель — запятая.
# По умолчанию создаются admin/admin123 и analyst/wb2024.
APP_USERS=admin:admin123,analyst:wb2024
